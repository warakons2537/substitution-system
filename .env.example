# FreeCloud / production guard
FREECLOUD_MODE=1
SEED_SAMPLE_DATA=0

# Supabase PostgreSQL: use Connect → Session pooler (port 5432)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Initial admin: only used when users table is empty
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=PLEASE_CHANGE_TO_A_LONG_RANDOM_PASSWORD
BOOTSTRAP_ADMIN_NAME=ผู้ดูแลระบบ

# Optional local storage
UPLOAD_DIR=./uploads

# Optional Supabase S3-compatible Storage
# S3_BUCKET=substitution-documents
# S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# S3_REGION=YOUR_PROJECT_REGION
# S3_ACCESS_KEY_ID=<key>
# S3_SECRET_ACCESS_KEY=<secret>
